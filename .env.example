API_ID=1234567                      # https://my.telegram.org -> API development tools
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456:ABC-from-BotFather
OWNER_ID=111111111                  # bot admin(s): your Telegram user id (comma separated for several)
PUBLIC_MODE=true                    # true = every user can add and customise their own channels; false = only OWNER_ID
MAX_CHANNELS_PER_USER=10            # channels one normal user may add (admins unlimited)
SOURCE_CHANNELS=                    # optional allow-list of channel ids (empty = every channel the bot is admin in)
DATA_FILE=data/settings.json        # where menu settings are saved (on Render: /var/data/settings.json, see render.yaml)
PORT=8080
LOG_LEVEL=INFO

# Optional speed tuning (seconds between edits; lower = faster, too low may trigger Telegram flood-waits)
# EDIT_DELAY=0.3
# AUTO_EDIT_DELAY=0.15
